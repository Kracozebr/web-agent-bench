{
  "name": "@web-agent-bench/benchmark-environment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:facilitator": "node dist/facilitator.js",
    "start:proxy": "node dist/proxy.js",
    "start:gateway": "node dist/gateway.js",
    "migrate": "tsx src/migrate.ts",
    "probe": "tsx src/probe.ts",
    "probe:task-transfer": "tsx src/probe/task-transfer-main.ts",
    "probe:task-reverse-swap": "tsx src/probe/task-reverse-swap-main.ts",
    "probe:task-native": "tsx src/probe/task-native-main.ts",
    "probe:task-resource-catalog": "tsx src/probe/task-resource-catalog-main.ts",
    "probe:task-reference": "tsx src/probe/task-reference-main.ts",
    "probe:task-h3": "tsx src/probe/task-h3-main.ts"
  },
  "dependencies": {
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/fastify": "2.28.0",
    "fastify": "5.12.7",
    "pg": "8.16.3",
    "viem": "2.47.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
